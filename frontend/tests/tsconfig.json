{
  // Type-checks the frontend tests (vitest only strips types), as tests/backend/tsconfig.json does
  // for the backend. Node types for the tests that read sources from disk; unused locals allowed.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["vite/client", "node"]
  },
  "include": ["../src", "."]
}
