{
  "name": "@blast-arena/backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "copy-locales": "node scripts/copy-locales.cjs",
    "prebuild": "npm run copy-locales",
    "build": "npm run build --workspace=@blast-arena/shared && tsc",
    "start": "node dist/index.js",
    "predev": "npm run copy-locales",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "cd .. && npx jest --config tests/backend/jest.config.ts"
  },
  "dependencies": {
    "@blast-arena/shared": "*",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "esbuild": "^0.28.2",
    "express": "^5.3.0",
    "i18next": "^26.4.3",
    "i18next-fs-backend": "^2.6.8",
    "ioredis": "^6.0.0",
    "isolated-vm": "^7.0.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "mysql2": "^3.24.5",
    "nodemailer": "^10.1.0",
    "otpauth": "^9.5.2",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
