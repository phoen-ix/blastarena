# Docker
COMPOSE_PROJECT_NAME=blast-arena
# NOTE: Nginx binds to 127.0.0.1:8280 (loopback) in docker-compose.yml and is meant to sit behind
# a host-level reverse proxy. APP_EXTERNAL_PORT is no longer wired into the production compose file.
APP_EXTERNAL_PORT=8080

# Database
DB_HOST=db
DB_PORT=3306
DB_NAME=blast_arena
DB_USER=blast_user
DB_PASSWORD=change_me_in_production
DB_ROOT_PASSWORD=change_root_password
DB_EXTERNAL_PORT=3307

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_EXTERNAL_PORT=6380

# Auth
JWT_SECRET=change_this_to_a_random_64_char_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
EMAIL_PEPPER=change_this_to_a_random_64_char_hex_string
# Required in production. Exactly 64 hex chars (32 bytes) — generate with: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=BlastArena

# App
APP_URL=http://localhost:8080
LOG_LEVEL=info
NODE_ENV=development

# Game logs (data/gamelogs). Persistent rooms tick continuously, so tick logging is gated on
# room activity. Pruning is a safety net against unbounded growth, not an archiving policy: it
# only ever removes logs where the peak player count was zero. Logs containing real gameplay are
# never deleted automatically, whatever these limits say.
GAME_LOG_IDLE_WINDOW_TICKS=60
GAME_LOG_MAX_AGE_DAYS=365
GAME_LOG_MAX_TOTAL_MB=20480

# Game
GAME_TICK_RATE=20
MAX_ROOMS=50
MAX_PLAYERS_PER_ROOM=8
BOMB_TIMER_SECONDS=3
POWERUP_DROP_CHANCE=0.3

# Rate Limits (requests per window)
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=3
RATE_LIMIT_API=100
