# Docker
COMPOSE_PROJECT_NAME=blast-arena
# NOTE: Nginx binds to 127.0.0.1:8280 (loopback) in docker-compose.yml and is meant to sit behind
# a host-level reverse proxy.

# Database. The db container creates the database and user from these only when data/db is
# first initialised; changing them later does not change the database.
DB_NAME=blast_arena
DB_USER=blast_user
DB_PASSWORD=change_me_in_production
DB_ROOT_PASSWORD=change_root_password

# Auth
JWT_SECRET=change_this_to_a_random_64_char_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
EMAIL_PEPPER=change_this_to_a_random_64_char_hex_string
# Required in production. Exactly 64 hex chars (32 bytes) — generate with: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=

# Email (SMTP): defaults until saved in Admin > Dashboard > Email / SMTP Settings, which also
# holds Security (STARTTLS / TLS / none; unset: TLS on port 465, else STARTTLS) and the EHLO name.
# Leave SMTP_HOST empty to only log emails. SMTP_HOST, SMTP_USER and SMTP_PASSWORD must be set
# together: the backend refuses to start with only some of them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=BlastArena
# Mail to an example.com sender is refused; set your real domain above.

# App
APP_URL=http://localhost:8080
LOG_LEVEL=info

# Game logs (data/gamelogs). Persistent rooms tick continuously, so tick logging is gated on
# room activity. Pruning is a safety net against unbounded growth, not an archiving policy: it
# only ever removes logs where the peak player count was zero. Logs containing real gameplay are
# never deleted automatically, whatever these limits say.
GAME_LOG_IDLE_WINDOW_TICKS=60
GAME_LOG_MAX_AGE_DAYS=365
GAME_LOG_MAX_TOTAL_MB=20480

# Match replays (data/replays): pruned by age, then by total size.
REPLAY_MAX_AGE_DAYS=365
REPLAY_MAX_TOTAL_MB=10240

# Also read by the backend, but not taken from this file: Compose passes the backend only the
# variables above, and docker-compose.yml fixes or leaves at the default (in brackets) these:
#   NODE_ENV (production; docker-compose.dev.yml: development), PORT (3000),
#   DB_HOST (db), DB_PORT (3306), REDIS_HOST (redis), REDIS_PORT (6379),
#   GAME_LOG_DIR (/app/gamelogs), REPLAY_DIR (/app/replays), SIMULATION_LOG_DIR (/app/simulations)
# Test stacks only (docker-compose.e2e.yml): API_RATE_LIMIT_PER_MIN (default 1000 per IP per
# minute), OPEN_WORLD_SEED (unset: a random open-world arena every round).

# Dev stack host ports (docker-compose.dev.yml): DEV_NGINX_PORT, DEV_VITE_PORT,
# DEV_DB_EXTERNAL_PORT, DEV_REDIS_EXTERNAL_PORT — defaults 8285, 5183, 3317, 6390.

# Game constants (tick rate, room/player caps, bomb timers, drop rates) live in
# shared/src/constants/game.ts; rate limits are set per route in the backend. Neither is
# configurable through the environment.
