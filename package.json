{
  "name": "blast-arena",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "docker compose -p blast-arena-dev -f docker-compose.yml -f docker-compose.dev.yml up --build",
    "prod": "docker compose up --build -d",
    "down": "docker compose down",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint shared/src backend/src frontend/src",
    "lint:fix": "eslint --fix shared/src backend/src frontend/src",
    "format": "prettier --write \"**/*.ts\"",
    "format:check": "prettier --check \"**/*.ts\"",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript-eslint": "^8.71.1"
  }
}
