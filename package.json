{
  "name": "blast-arena",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "docker compose -p blast-arena-dev -f docker-compose.yml -f docker-compose.dev.yml up --build",
    "prod": "docker compose up --build -d",
    "down": "docker compose down",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint shared/src backend/src frontend/src",
    "lint:fix": "eslint --fix shared/src backend/src frontend/src",
    "format": "prettier --write \"**/*.ts\"",
    "format:check": "prettier --check \"**/*.ts\"",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch": "^11.0.3",
    "glob": "^14.0.3"
  }
}
